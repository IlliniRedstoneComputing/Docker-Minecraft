# Environment variables for Docker Compose
# Copy this file to .env.local and customize as needed

# Hostname configurations
MINECRAFT_HOSTNAME=mc.example.com.localhost

# SFTPGo external auth configuration
SFTPGO_AUTH_HOOK=http://localhost:3000/none
SFTPGO_AUTH_SECRET=secret

# Luckperms DB configuration
LUCKPERMS_DB_ROOT_PASSWORD=rootpassword
LUCKPERMS_DB_USER=luckperms_user
LUCKPERMS_DB_PASSWORD=luckperms_password
LUCKPERMS_DB=luckperms

# Luckperms messaging configuration
LUCKPERMS_MESSENGER_PASSWORD=luckperms_password

# Luckperms Configuration
LUCKPERMS_SECRET=api_secret 

# Velocity Configuration
VELOCITY_SECRET=velocity_secret 
